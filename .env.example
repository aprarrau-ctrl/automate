# ── Notion ────────────────────────────────────────────────────────────────────
# Token de tu integración: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxx

# ID de la base de datos de movimientos (de la URL de Notion)
NOTION_DATABASE_ID=830abf35cb0549b89a639f86a3885565

# Nombres exactos de las propiedades en tu BD de Notion.
# Ajusta estos valores si los campos tienen nombres diferentes.
NOTION_PROP_TITLE=Descripción
NOTION_PROP_AMOUNT=Monto
NOTION_PROP_DATE=Fecha
NOTION_PROP_TYPE=Tipo
NOTION_PROP_BANK=Banco
NOTION_PROP_MERCHANT=Comercio
NOTION_PROP_SOURCE=Fuente
NOTION_PROP_NOTES=Notas

# ── Gmail ─────────────────────────────────────────────────────────────────────
# Cuántos días atrás buscar emails en cada ejecución (default: 30)
GMAIL_LOOKBACK_DAYS=30
